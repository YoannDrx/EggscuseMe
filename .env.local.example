# =============================================================================
# EggscuseMe - Development Environment (.env.local)
# =============================================================================
# Copy this file to .env.local for local development
# This file uses the Neon "dev" branch (separate from production)
#
# IMPORTANT: .env.local is gitignored and takes priority over .env
# =============================================================================

# === DATABASE (Neon Dev Branch) ===
# These URLs point to the "dev" branch, NOT production
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# === BETTER AUTH ===
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

## === NOTIFICATIONS PUSH ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# === OTHER SERVICES (copy from .env or use test values) ===
# REDIS_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === SCANNER (Vision / OCR) ===
GEMINI_API_KEY=""
# Optional: override Gemini vision model (ex: gemini-2.0-pro)
GEMINI_VISION_MODEL=""
# Optional: use OpenAI Vision instead of Gemini ("gemini" | "openai")
VISION_PROVIDER="gemini"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
