/// Model for tracking vision scan usage (rate limiting)
model VisionScanUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String   // Format: YYYY-MM-DD (to count scans per day)
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
