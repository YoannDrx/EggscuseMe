# === DATABASE (Neon Dev Branch) ===
# These URLs point to the "dev" branch, NOT production
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-winter-boat-abdb9hwn-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-winter-boat-abdb9hwn.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# === BETTER AUTH ===
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-dev-secret-here"

