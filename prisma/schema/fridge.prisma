// EggscuseMe - Fridge System (Simplified architecture)
// Replaces the complex Organization system with a simple Fridge model

model Fridge {
  id   String @id @default(nanoid(11))
  name String @default("Mon Frigo")

  // Owner of the fridge (Chef plan can have multiple fridges)
  ownerId   String
  owner     User    @relation("OwnedFridge", fields: [ownerId], references: [id], onDelete: Cascade)
  isDefault Boolean @default(true) // Primary fridge for the user

  // Fridge type/location for multi-fridge (Chef plan)
  fridgeType FridgeType @default(MAIN)
  location   String? // Custom location description

  // Guest members
  members FridgeMember[]

  // Egg boxes in this fridge
  eggBoxes EggBox[]

  // Share links for inviting guests
  shareLinks FridgeShareLink[]

  // Email invitations
  emailInvitations FridgeEmailInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("fridge")
}

enum FridgeType {
  MAIN // Main kitchen fridge
  CELLAR // Cave / Cellar
  GARAGE // Garage fridge
  SECONDARY // Secondary kitchen fridge
  OTHER // Other location
}

model FridgeMember {
  id String @id @default(nanoid(11))

  fridgeId String
  fridge   Fridge @relation(fields: [fridgeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("FridgeMemberships", fields: [userId], references: [id], onDelete: Cascade)

  role FridgeRole @default(GUEST)

  createdAt DateTime @default(now())

  @@unique([fridgeId, userId])
  @@index([userId])
  @@map("fridge_member")
}

enum FridgeRole {
  OWNER // Full control (but owner is defined via Fridge.ownerId)
  GUEST // Can view and consume eggs
}

model FridgeShareLink {
  id   String @id @default(nanoid(11))
  code String @unique @default(nanoid(8)) // Short shareable code

  fridgeId    String
  fridge      Fridge @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  createdById String // User who created the invite

  expiresAt DateTime // When the link expires
  maxUses   Int      @default(5) // Maximum number of uses
  usedCount Int      @default(0) // How many times used
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([fridgeId])
  @@map("fridge_share_link")
}

// Invitation status for email invitations
enum InvitationStatus {
  PENDING // Invitation sent, waiting for response
  ACCEPTED // Invitation accepted
  EXPIRED // Invitation expired (after 7 days)
  CANCELLED // Invitation cancelled by owner
}

// Email-based invitations for fridge sharing
model FridgeEmailInvitation {
  id    String @id @default(nanoid(11))
  token String @unique @default(nanoid(32)) // Secure token for invitation link

  fridgeId String
  fridge   Fridge @relation(fields: [fridgeId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  email  String // Email of the invited person
  status InvitationStatus @default(PENDING)

  acceptedById String? // User ID if accepted (can be different from original email)
  acceptedBy   User?     @relation("ReceivedInvitations", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?

  expiresAt  DateTime // Expiration date (7 days by default)
  lastSentAt DateTime @default(now()) // Last time the email was sent (for resend cooldown)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fridgeId, email]) // One invitation per email per fridge
  @@index([email])
  @@index([token])
  @@index([fridgeId])
  @@map("fridge_email_invitation")
}

// User subscription - directly linked to User (not Organization)
model UserSubscription {
  id     String @id @default(nanoid(11))
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                 String    @default("free") // free, pro, ultra
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String? // active, trialing, canceled, past_due
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  subscriptionPlan     String?
  subscriptionStatus   String?
  oneTimePlan          String?
  oneTimeGrantedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_subscription")
}

model BillingPurchase {
  id                String   @id @default(nanoid(11))
  userId            String
  plan              String
  checkoutSessionId String   @unique
  paymentIntentId   String   @unique
  amount            Int
  currency          String
  paidAt            DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
  @@map("billing_purchase")
}
