// Better Auth Schema - Simplified (Organization plugin removed)

model User {
  id              String   @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  resendContactId String?

  // Outgoing
  sessions  Session[]
  accounts  Account[]
  feedbacks Feedback[]

  // EggscuseMe relations
  eggBoxes        EggBox[]
  eggConsumptions EggConsumption[]
  preferences     UserPreferences?

  // Fridge system
  stripeCustomerId  String? // Stripe customer ID directly on user
  userSubscription  UserSubscription? // Subscription linked to user
  ownedFridge       Fridge?           @relation("OwnedFridge") // One fridge per user
  fridgeMemberships FridgeMember[]    @relation("FridgeMemberships") // Guest access to other fridges

  // Email invitations
  sentInvitations     FridgeEmailInvitation[] @relation("SentInvitations") // Invitations sent by this user
  receivedInvitations FridgeEmailInvitation[] @relation("ReceivedInvitations") // Invitations accepted by this user

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Admin logs
  adminLogs       AdminLog[] @relation("AdminLogs")       // Logs created by this admin
  adminLogTargets AdminLog[] @relation("AdminLogTargets") // Logs targeting this user

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
